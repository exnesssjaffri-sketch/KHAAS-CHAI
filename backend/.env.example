# Server
PORT=3000
NODE_ENV=development

# Supabase (get from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Order email automation (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Khaas Chai <orders@your-verified-domain.com>

# Used only by a real payment provider webhook when marking an order paid
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
